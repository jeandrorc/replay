{
  "name": "@replay/collector",
  "version": "0.0.0",
  "private": true,
  "description": "Replay system activity collector adapters",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint 'src/**/*.ts' --max-warnings 0",
    "test": "node --test dist/__tests__/*.test.js ../../scripts/harness/package-entry-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@replay/application": "workspace:*",
    "@replay/domain": "workspace:*"
  }
}
