{
  "name": "replay",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first activity timeline for reconstructing developer worklogs.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm lint:md && corepack pnpm harness:check && corepack pnpm architecture:check && corepack pnpm typecheck && corepack pnpm test",
    "architecture:check": "node --test scripts/architecture/*.test.mjs && node scripts/architecture/check.mjs",
    "build": "node scripts/harness/run-turbo-task.mjs build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/harness/run-turbo-task.mjs lint",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules'",
    "harness:check": "node scripts/harness/check.mjs",
    "harness:test": "node --test scripts/harness/*.test.mjs",
    "security:audit": "corepack pnpm audit --audit-level moderate",
    "test": "corepack pnpm harness:test && node scripts/harness/run-turbo-task.mjs test",
    "typecheck": "node scripts/harness/run-turbo-task.mjs typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "markdownlint-cli2": "0.23.1",
    "prettier": "3.6.2",
    "turbo": "2.10.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0"
  }
}
